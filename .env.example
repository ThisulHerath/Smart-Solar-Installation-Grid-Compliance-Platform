# ==================================================
# Smart Solar Installation & Grid Compliance Platform
# Environment Variables Example
# ==================================================

# Database: Neon Managed PostgreSQL
# Format: Host=ep-xyz.region.aws.neon.tech;Database=neondb;Username=role_name;Password=secret;SSL Mode=Require;Trust Server Certificate=true
DATABASE_CONNECTION_STRING=Host=ep-steep-band-56603943.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_NEON_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# JWT Authentication
JWT_KEY=SmartSolarSuperSecretKeyForDevelopmentAndJwtAuthentication2026!
JWT_ISSUER=SmartSolarPlatform
JWT_AUDIENCE=SmartSolarClients
JWT_EXPIRE_MINUTES=60

# Internal Agentic AI Service
AGENTIC_AI_BASE_URL=http://localhost:8000
AGENTIC_AI_INTERNAL_KEY=smart-solar-ai-internal-key-development

# Frontend Web Environment (Vite)
VITE_API_BASE_URL=http://localhost:5000
