# ==================================================
# Smart Solar Installation & Grid Compliance Platform
# Environment Variables Example
# ==================================================

# Database: Neon Managed PostgreSQL
# Format: Host=ep-xyz.region.aws.neon.tech;Database=neondb;Username=role_name;Password=secret;SSL Mode=Require;Trust Server Certificate=true
DATABASE_CONNECTION_STRING=<your-neon-postgresql-connection-string>

# JWT Authentication
JWT_KEY=<generate-a-long-random-signing-key>
JWT_ISSUER=<your-jwt-issuer>
JWT_AUDIENCE=<your-jwt-audience>
JWT_EXPIRE_MINUTES=60

# Internal Agentic AI Service
AGENTIC_AI_BASE_URL=<agentic-ai-service-url>
AGENTIC_AI_INTERNAL_KEY=<generate-a-random-internal-service-key>

# Frontend Web Environment (Vite)
VITE_API_BASE_URL=http://localhost:5116

# Comma-separated HTTPS web origins when hosting the API
CORS_ALLOWED_ORIGINS=
ENABLE_SWAGGER=false

# Email delivery: smtp (generic SMTP/Gmail) or brevo.
EMAIL_PROVIDER=smtp

# Brevo: use the SMTP login and SMTP key, not your account password or API key.
# BREVO_FROM_EMAIL must be a sender verified in your Brevo account.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=

# Email verification — Gmail requires a Google-generated App Password.
# Enable 2-Step Verification, then create an App Password in your Google Account.
# Keep the real values only in .env or your hosting provider's secret settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional sender override (must be permitted by your Gmail account).
SMTP_FROM_EMAIL=
